rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // Admin is hardcoded by uid. Kevin: paste your Firebase Auth User UID here
    // (Firebase console -> Authentication -> Users -> your account -> User UID).
    function isAdmin() {
      return isSignedIn() && request.auth.uid in [
        "G7QUZ8Kat1fgyoMjdGKz4DYoVHi1"
      ];
    }

    function profileExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }
    function profileData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // assignedTrainerId of ownerUid, or null if the profile or the field is
    // missing. The exists() guard + .get(...,null) default keep this from
    // throwing on a missing profile or absent/null field (which would
    // otherwise deny — or worse, error — unpredictably).
    function assignedTrainerOf(ownerUid) {
      return profileExists(ownerUid)
        ? profileData(ownerUid).get('assignedTrainerId', null)
        : null;
    }

    // Is the requester the direct trainer of ownerUid?
    function isDirectTrainer(ownerUid) {
      return assignedTrainerOf(ownerUid) != null
        && request.auth.uid == assignedTrainerOf(ownerUid);
    }

    // Is the requester the head above ownerUid's direct trainer?
    // Guarded so a missing trainer profile can't throw the nested get().
    function isHeadOfTrainer(ownerUid) {
      return assignedTrainerOf(ownerUid) != null
        && profileExists(assignedTrainerOf(ownerUid))
        && request.auth.uid ==
             profileData(assignedTrainerOf(ownerUid)).get('headTrainerId', null);
    }

    function canAccessUserData(ownerUid) {
      return isSignedIn() && (
        // owner and admin first so the common path does NO document lookups
        request.auth.uid == ownerUid
        || isAdmin()
        || isDirectTrainer(ownerUid)
        || isHeadOfTrainer(ownerUid)
      );
    }

    match /users/{uid} {
      // READ: scoped (hardening — was "any signed-in user").
      //  • owner reads own; admin reads any
      //  • TRAINER profiles (head/sub) are a readable directory — needed so a
      //    client can resolve/validate a trainer at join time and show the
      //    trainer's name, and so getMySubTrainers (headTrainerId==me) lists work
      //  • a trainer reads their DIRECT clients (assignedTrainerId==me) — powers
      //    the getMyClients list query
      //  • a head reads profiles where they're the head (headTrainerId==me)
      // Uses resource.data (NOT get()) so the constrained list queries stay valid.
      // Net effect: a client can no longer read another client's profile.
      allow read: if isSignedIn() && (
        request.auth.uid == uid
        || isAdmin()
        || resource.data.role in ['head_trainer', 'sub_trainer']
        || resource.data.assignedTrainerId == request.auth.uid
        || resource.data.headTrainerId == request.auth.uid
      );

      // CREATE: only your own uid; role must be client or head_trainer ONLY
      // (never admin / sub_trainer); uid field must equal the doc id. Billing
      // can't be self-granted at signup: no entitlements, and subscription may
      // only start as "trial" (Stripe/admin flips it to "active" later).
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role in ['client', 'head_trainer']
        && !request.resource.data.keys().hasAny(['entitlements', 'sessionCredits', 'sessionBillingHold', 'sessionPaymentMethod', 'sessionBillingTest'])
        && request.resource.data.get('subscriptionStatus', 'trial') == 'trial';

      // UPDATE: admin anything; owner may update own profile but MUST NOT
      // change role (blocks self-promotion) and MUST NOT touch the billing /
      // trial fields — the AI budget tier and the Pro food-data gate read
      // subscriptionStatus/entitlements from this doc, so owner-writable
      // billing fields were a self-serve Pro upgrade + infinite-trial hole.
      //
      // S100b adds the SESSION-BILLING fields to the same locked set:
      //  • sessionCredits — prepaid training sessions in the bank. Owner-writable
      //    would be "grant yourself 100 free sessions with your trainer".
      //  • sessionBillingHold — the lockout flag after a declined weekly charge.
      //    Owner-writable would let a client clear their own unpaid hold.
      //  • sessionPaymentMethod — the saved-card pointer. Owner-writable would
      //    let a client fake having a card on file (or point billing at someone
      //    else's payment method id). Written ONLY by recordSessionConsent,
      //    which re-reads the card from Stripe rather than trusting the browser.
      // Both are written ONLY by the Admin SDK (purchase + settle dispatchers).
      // NOTE: sessionPolicy / sessionPacks are deliberately NOT locked — they are
      // the TRAINER's own cancellation window and price list on their OWN profile,
      // and trainer-set pricing is a core product principle. A trainer editing
      // their own policy can only affect their own business; the fields are read
      // by clients through the existing trainer-directory read rule.
      allow update: if isAdmin()
        || (
          request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['subscriptionStatus', 'entitlements', 'trialStartedAt', 'trialLengthDays',
                        'sessionCredits', 'sessionBillingHold', 'sessionPaymentMethod', 'sessionBillingTest',
                        // The terms that govern this client's charges, mirrored
                        // from their signed consent. The UI quotes fees from it,
                        // so a client who could edit it could quote themselves $0.
                        'sessionConsentPolicy', 'stripeLivemode'])
          // JOINING a trainer is server-side only (S179 free roster cap): a
          // client cannot count a trainer's roster — the scoped read rules stop
          // them reading other profiles — so the cap has to be enforced in
          // joinTrainerByCode, and this stops that being decorative.
          // LEAVING stays a client self-write on purpose: setting the field to
          // null is always allowed. Leaving your trainer should never need a
          // server round trip, and should never be something we can refuse.
          && (
            request.resource.data.get('assignedTrainerId', null)
              == resource.data.get('assignedTrainerId', null)
            || request.resource.data.get('assignedTrainerId', null) == null
          )
        );

      // DELETE: admin only.
      allow delete: if isAdmin();

      // Sensitive per-user app data. Owner, admin, the owner's direct trainer,
      // or the head above that trainer may read AND write.
      match /kv/{docId} {
        allow read, write: if canAccessUserData(uid);
      }

      // PRIVATE per-user storage (S91, notes): OWNER ONLY — deliberately NOT
      // the kv trainer-chain access. A client's private notes are readable by
      // nobody else: not their trainer, not the head, not another client, and
      // not even the admin via the client SDK. (Cloud Functions use the Admin
      // SDK which bypasses rules — the AI tools enforce caller==target for
      // this store in code, so the AI can never surface private notes to a
      // trainer either.)
      match /privkv/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Is trainerUid actually the trainer over clientUid — either their direct
    // trainer (assignedTrainerId) or the head above that trainer? Pair check
    // independent of who the requester is (messaging: either side may create).
    function isTrainerOf(trainerUid, clientUid) {
      return assignedTrainerOf(clientUid) != null && (
        assignedTrainerOf(clientUid) == trainerUid
        || (profileExists(assignedTrainerOf(clientUid))
            && profileData(assignedTrainerOf(clientUid)).get('headTrainerId', null) == trainerUid)
      );
    }

    // ── In-app messaging (S90, docs/MESSAGING-PLAN.md) ────────────────────────
    // One thread per linked trainer↔client pair; doc id = "{trainerUid}_{clientUid}"
    // (deterministic — no lookup needed). Only the two participants can see it;
    // creating one requires the pair to be REALLY linked. Messages are append-only
    // (no edit/delete in v1 — keeps the rules tight; admin can delete to moderate).
    // Note: the unread map is a UX convenience between two already-linked people —
    // field-level unread math is deliberately not policed (worst case: a badge).
    match /threads/{tid} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.keys().hasOnly(['participants', 'trainerUid', 'clientUid', 'lastMsg', 'lastFrom', 'updatedAt', 'unread'])
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] == request.resource.data.trainerUid
        && request.resource.data.participants[1] == request.resource.data.clientUid
        && tid == request.resource.data.trainerUid + '_' + request.resource.data.clientUid
        && isTrainerOf(request.resource.data.trainerUid, request.resource.data.clientUid);
      // participants/trainerUid/clientUid are immutable — only the message
      // metadata may change, and lastFrom must be one of the two participants.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMsg', 'lastFrom', 'updatedAt', 'unread'])
        && request.resource.data.get('lastFrom', '') in resource.data.participants;
      allow delete: if isAdmin();

      match /msgs/{mid} {
        function threadData() {
          return get(/databases/$(database)/documents/threads/$(tid)).data;
        }
        allow read: if isSignedIn() && request.auth.uid in threadData().participants;
        allow create: if isSignedIn()
          && request.auth.uid in threadData().participants
          && request.resource.data.from == request.auth.uid
          // S124: a message may optionally be a TO-DO pointer — kind:"todo" plus
          // the id of an item in the client's caliq-requests. Status is NOT
          // stored here on purpose: the kv request stays the single source of
          // truth, so a to-do can never read "open" in chat and "done" on the
          // home screen. Messages remain append-only.
          // S183g: a second pointer kind — "meal", a meal the CLIENT tagged and
          // sent for their trainer to check. Same discipline as todo: the
          // message carries only the id, never the meal or its status. The
          // meal lives in the client's day log and the review row in their kv,
          // so chat can never disagree with the food log.
          && request.resource.data.keys().hasOnly(['from', 'text', 'ts', 'kind', 'todoId', 'reviewId'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && (!('kind' in request.resource.data)
              || request.resource.data.kind == 'todo' || request.resource.data.kind == 'meal')
          && (!('todoId' in request.resource.data)
              || (request.resource.data.todoId is string
                  && request.resource.data.todoId.size() > 0
                  && request.resource.data.todoId.size() <= 64))
          && (!('reviewId' in request.resource.data)
              || (request.resource.data.reviewId is string
                  && request.resource.data.reviewId.size() > 0
                  && request.resource.data.reviewId.size() <= 64))
          // kind:"todo" is only meaningful with an id, and only a TRAINER sends
          // to-dos (a client sending one would be a fake assignment).
          && (!('kind' in request.resource.data) || request.resource.data.kind != 'todo'
              || ('todoId' in request.resource.data
                  && request.auth.uid == threadData().trainerUid))
          // kind:"meal" is the mirror image — only the CLIENT tags their own
          // meal. A trainer sending one would be putting words in the client's
          // mouth about what they ate.
          && (!('kind' in request.resource.data) || request.resource.data.kind != 'meal'
              || ('reviewId' in request.resource.data
                  && request.auth.uid != threadData().trainerUid))
          // A bare pointer id with no matching kind is meaningless, and would
          // let either field be smuggled onto an ordinary message.
          && (!('todoId' in request.resource.data)
              || ('kind' in request.resource.data && request.resource.data.kind == 'todo'))
          && (!('reviewId' in request.resource.data)
              || ('kind' in request.resource.data && request.resource.data.kind == 'meal'));
        allow update: if false; // append-only
        allow delete: if isAdmin();
      }
    }

    // ── Training sessions / appointments (S100, docs/SESSIONS-BILLING-PLAN.md) ─
    // One doc per booked session at sessions/{sid}, readable only by the two
    // people in it. The TRAINER books (a client can't create sessions for
    // themselves); either side may cancel. Queries use
    // where('participants','array-contains', myUid) — a single-field index, so
    // no composite index is needed; ordering happens client-side.
    //
    // ⚠️ BILLING FIELDS ARE SERVER-ONLY. settled/settledAt/chargeId/
    // completedAt/settleAttempts decide whether real money moves, so NEITHER
    // participant may write them from the client SDK — only the Admin SDK
    // (the scheduled settle dispatcher) can. Same lesson as subscriptionStatus
    // in S85: if a field gates money or entitlement, the owner can't own it.
    match /sessions/{sid} {
      function bookingFields() {
        return ['participants', 'trainerUid', 'clientUid', 'startAt', 'durationMin',
                'status', 'title', 'location', 'priceCents',
                'createdBy', 'createdAt', 'updatedAt',
                'cancelledBy', 'cancelledAt', 'cancelReason',
                // Trainer-only judgements on a DELIVERED session (S186). Both
                // reduce or zero what is charged, never increase it, so the
                // client is never exposed by them being writable here.
                'noShow', 'waived',
                // Recurrence bookkeeping — which series a session belongs to.
                'seriesId', 'seriesIndex'];
      }
      // Fields a CLIENT is allowed to touch — cancelling their own session and
      // nothing else (they can't move it, re-price it, or un-cancel it).
      function clientCancelFields() {
        return ['status', 'cancelledBy', 'cancelledAt', 'cancelReason', 'updatedAt'];
      }
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }
      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      // ⚠️ cancelledAt decides whether a LATE-CANCEL FEE applies, so it cannot be
      // a number the canceller just types. Without this, a client cancelling 1
      // hour before a session could write cancelledAt = "3 days ago" and slip
      // outside the trainer's window for free. Pinned to server time
      // (request.time) with ±5 min of slack for honest device-clock skew —
      // far too tight to fake the hours-scale backdating the fee turns on, and
      // it binds the TRAINER symmetrically so neither side can rewrite history.
      // The ±5 min stays SYMMETRIC on purpose. A one-sided bound would reject
      // the write outright from any device whose clock runs even a second fast,
      // which means "you cannot cancel at all" — a worse failure than the one it
      // fixes. The forward half does shift the fee boundary against the client
      // by up to five minutes, so the SETTLE ENGINE forgives exactly this much
      // notice when pricing a late cancel (SKEW_GRACE_MS in sessionSettle.js).
      // Skew is absorbed where it can be made client-favourable, not where it
      // can lock someone out. (S186)
      function cancelStampHonest() {
        return !changed().hasAny(['cancelledAt'])
          || (request.resource.data.cancelledAt is number
              && request.resource.data.cancelledAt >= request.time.toMillis() - 300000
              && request.resource.data.cancelledAt <= request.time.toMillis() + 300000);
      }
      // ⚠️ WHO cancelled decides who pays. `cancelledBy` was unguarded while
      // `cancelledAt` was carefully pinned — so a client could write
      // {status:'cancelled', cancelledBy:<trainerUid>} from the browser console
      // and the settle engine, which treats a trainer cancellation as free,
      // would never bill it. Every session, free, forever. It also worked in
      // reverse: a trainer could stamp a client's uid on their OWN cancellation
      // and bill the client for it, which terms.html §6 promises never happens.
      // Whoever writes it must be who it names.
      function cancelledByHonest() {
        return !changed().hasAny(['cancelledBy'])
          || request.resource.data.get('cancelledBy', '') == request.auth.uid;
      }
      // A cancellation is a statement about a session that HASN'T HAPPENED YET.
      // Without this, a delivered session could be "cancelled" after the fact —
      // turning a full-price charge into a late-cancel fee, or nothing at all —
      // and the stored dispute evidence rendered a negative notice period
      // ("-96.5h notice"), which would lose the chargeback on its own.
      function stillCancellable() {
        return !('completedAt' in resource.data)
          && resource.data.get('startAt', 0) > request.time.toMillis();
      }
      // A delivered session's price is settled history. It stays editable while
      // the session is still upcoming (typos happen); once it is delivered or
      // cancelled, the amount is frozen — the server bills from `billableCents`,
      // and the client has already been quoted a fee against this number.
      function priceFrozenOnceFinal() {
        return !changed().hasAny(['priceCents'])
          || (!('completedAt' in resource.data) && resource.data.get('status', '') != 'cancelled');
      }
      // Rescheduling has the same floor as booking (S195). Without it the
      // create-time bound is decorative: book for tomorrow, then move it to
      // last spring — a session the client is billed for at a time they never
      // had one. Only checked when startAt actually MOVES, so a delivered
      // session sitting legitimately in the past can still be marked a no-show
      // or waived, which are the edits that only ever reduce a charge.
      function startAtInBounds() {
        return !changed().hasAny(['startAt'])
          || request.resource.data.startAt > request.time.toMillis() - 1296000000;
      }
      // The identity of the booking can never be rewritten after creation.
      function identityIntact() {
        return request.resource.data.trainerUid == resource.data.trainerUid
          && request.resource.data.clientUid == resource.data.clientUid
          && request.resource.data.participants == resource.data.participants
          && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
          && request.resource.data.get('createdAt', 0) == resource.data.get('createdAt', 0);
      }

      allow read: if isParticipant() || isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(bookingFields())
        && request.resource.data.keys().hasAll(['participants', 'trainerUid', 'clientUid', 'startAt', 'durationMin', 'status'])
        // Only the trainer books, and only for a client really linked to them.
        && request.auth.uid == request.resource.data.trainerUid
        && isTrainerOf(request.resource.data.trainerUid, request.resource.data.clientUid)
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] == request.resource.data.trainerUid
        && request.resource.data.participants[1] == request.resource.data.clientUid
        && request.resource.data.trainerUid != request.resource.data.clientUid
        // A new booking always starts scheduled and unsettled.
        && request.resource.data.status == 'scheduled'
        && request.resource.data.startAt is number
        // ⚠️ HOW FAR BACK A SESSION MAY BE BOOKED (S195). Back-dating is real
        // bookkeeping — a trainer entering Friday's session on Sunday — and it
        // charges a real card for work the client never watched being booked,
        // which makes it the most disputable write in this collection. The app
        // caps it at 14 days (BACKDATE_MAX_DAYS in src/sessions.js) and warns
        // before saving; this is the same bound where it can't be bypassed by
        // a console write or a stale build. Deliberately 15 days rather than 14
        // so an honest booking at the app's limit can never be refused by the
        // gap between the browser's clock and the server's.
        //
        // It is also what keeps a back-dated session BILLABLE: nothing settles
        // until the completion sweep stamps it, and that sweep only looks back
        // LOOKBACK_DAYS (21). A session older than this bound would be booked,
        // never stamped, and never paid — an invisible failure, which is worse
        // than a refusal the trainer can see and act on.
        && request.resource.data.startAt > request.time.toMillis() - 1296000000
        && request.resource.data.durationMin is number
        && request.resource.data.durationMin > 0
        && request.resource.data.durationMin <= 480
        && request.resource.data.get('priceCents', 0) is number
        && request.resource.data.get('priceCents', 0) >= 0
        && request.resource.data.get('priceCents', 0) <= 500000
        // A booking can't be born already judged.
        && request.resource.data.get('noShow', false) == false
        && request.resource.data.get('waived', false) == false;

      // TRAINER: may reschedule, re-price, retitle, cancel, or mark a delivered
      // session as a no-show / waived — but never write a billing field and
      // never rewrite whose session it is.
      allow update: if isParticipant()
        && request.auth.uid == resource.data.trainerUid
        && changed().hasOnly(bookingFields())
        && identityIntact()
        && cancelStampHonest()
        && cancelledByHonest()
        && priceFrozenOnceFinal()
        && startAtInBounds()
        // Cancelling is only for a session that hasn't happened. Marking a
        // delivered one no-show or waived is a different action and stays open.
        && (!changed().hasAny(['status']) || request.resource.data.status != 'cancelled' || stillCancellable())
        && request.resource.data.status in ['scheduled', 'cancelled']
        && request.resource.data.get('noShow', false) is bool
        && request.resource.data.get('waived', false) is bool
        && request.resource.data.durationMin is number
        && request.resource.data.durationMin > 0
        && request.resource.data.durationMin <= 480;

      // CLIENT: cancel only. Status may go to 'cancelled' and nothing else may
      // move — and only while the session is still ahead of them.
      allow update: if isParticipant()
        && request.auth.uid == resource.data.clientUid
        && changed().hasOnly(clientCancelFields())
        && identityIntact()
        && cancelStampHonest()
        && cancelledByHonest()
        && stillCancellable()
        && request.resource.data.status == 'cancelled';

      // Deleting would erase billing history — cancel instead. Admin only.
      allow delete: if isAdmin();
    }

    // ── Trainer time blocks (S190) ────────────────────────────────────────
    // "Busy", "Lunch", "Away" — time the trainer is not available, with no
    // client attached. Deliberately NOT a session: a session has two people, a
    // price and a billing lifecycle, and a block has none of those. Putting
    // them in the same collection would mean the settle sweep had to learn to
    // ignore something, which is exactly the kind of exception that later gets
    // billed by accident.
    //
    // ⚠️ READ IS OWNER-ONLY, ON PURPOSE. Clients never read these directly —
    // free/busy is served by a callable that strips every detail down to a time
    // range. A block's title ("Physio", "Dentist") is the trainer's private
    // business, and the same reasoning keeps sessions participant-only: a
    // client browsing raw calendar docs would see other clients' names.
    match /trainerBlocks/{bid} {
      function blockFields() {
        return ['trainerUid', 'startAt', 'durationMin', 'title', 'seriesId',
                'createdAt', 'updatedAt'];
      }
      allow read: if isSignedIn() && (resource.data.trainerUid == request.auth.uid || isAdmin());
      // Trainers only. Self-owned junk from a client would be inert, but this is
      // a shared collection and "anyone may write here" is not a property worth
      // having — the get() costs one read on a write that happens a few times a
      // week, which is the cheapest possible place to pay for it.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(blockFields())
        && request.resource.data.keys().hasAll(['trainerUid', 'startAt', 'durationMin'])
        && request.resource.data.trainerUid == request.auth.uid
        && profileData(request.auth.uid).get('role', '') in ['head_trainer', 'sub_trainer', 'admin']
        && request.resource.data.startAt is number
        && request.resource.data.durationMin is number
        && request.resource.data.durationMin > 0
        && request.resource.data.durationMin <= 1440;
      allow update: if isSignedIn()
        && resource.data.trainerUid == request.auth.uid
        && request.resource.data.trainerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(blockFields())
        && request.resource.data.durationMin is number
        && request.resource.data.durationMin > 0
        && request.resource.data.durationMin <= 1440;
      // A block carries no billing history, so unlike a session it is safe to
      // delete outright.
      allow delete: if isSignedIn() && (resource.data.trainerUid == request.auth.uid || isAdmin());
    }

    // ── Session charge ledger (S101c) ─────────────────────────────────────
    // One doc per settlement attempt (a batch of sessions, or a late-cancel
    // fee): what was charged, why, its Stripe id, and the dispute evidence.
    // Written ONLY by the settle dispatcher (Admin SDK) — money records are
    // never client-writable. Both participants can read their own, which is
    // what powers the client's "what was I charged for" view and the
    // trainer's earnings list.
    match /sessionCharges/{cid} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.trainerUid
        || request.auth.uid == resource.data.clientUid
        || isAdmin());
      allow write: if false; // Admin SDK only
    }

    // Friendly invite-code lookup: doc id = the CODE, data = { trainerUid }.
    // Lets a not-yet-linked client resolve a code to a trainer with a single
    // doc read instead of querying the whole users collection — which is what
    // lets us tighten profile-doc reads later (docs/BLAZE_MIGRATION.md step 5).
    // A code can only be claimed by the trainer it points to, and once claimed
    // cannot be overwritten by anyone else (no code hijacking).
    match /inviteCodes/{code} {
      // GET by code is how a client resolves an invite — but collection-wide
      // LIST would let any signed-in user harvest every code → trainer mapping
      // (codes are semi-secret capability tokens). The app only ever does
      // point-gets by doc id.
      allow get: if isSignedIn();
      allow list: if isAdmin();
      // create only when the doc doesn't exist yet, pointing at yourself,
      // with exactly the expected fields
      allow create: if isSignedIn()
        && request.resource.data.trainerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['trainerUid', 'createdAt']);
      // update only by the trainer the code already points to (refresh), still self
      allow update: if isSignedIn()
        && resource.data.trainerUid == request.auth.uid
        && request.resource.data.trainerUid == request.auth.uid;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.trainerUid == request.auth.uid);
    }
  }
}
